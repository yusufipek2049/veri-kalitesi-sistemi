      "bind": "0.0.0.0:8000",
      "compose_service": "api"
    },
    {
      "name": "worker",
      "entrypoint_chain": [
        "infra/development/compose.yaml command → dq-worker",
        "pyproject.toml [project.scripts] dq-worker = veri_kalitesi.jobs.entrypoint:main",
        "src/veri_kalitesi/jobs/entrypoint.py → create_production_worker()",
        "src/veri_kalitesi/jobs/production.py → create_persistent_job_runtime()",
        "src/veri_kalitesi/jobs/composition.py → PersistentJobWorker",
        "src/veri_kalitesi/jobs/worker.py → run_forever() poll loop"
      ],
      "compose_service": "worker"
    },
    {
      "name": "migrate",
      "entrypoint_chain": [
        "infra/development/compose.yaml command → alembic upgrade head",
        "alembic/env.py → DatabaseSettings.from_url() → run_migrations_online()"
      ],
      "compose_service": "migrate",
      "depends_on": "postgres (healthy)"
    },
    {
      "name": "frontend",
      "entrypoint_chain": [
        "infra/development/compose.yaml → node:22.17-alpine npm run dev",
        "frontend/vite.config.ts dev server"
      ],
      "bind": "0.0.0.0:5173",
      "compose_service": "frontend"
    }
  ],
