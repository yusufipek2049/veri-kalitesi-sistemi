{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-handoff/CURRENT_TASK.schema.json",
  "title": "Hermes Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_status",
    "task_id",
    "title",
    "objective",
    "repository",
    "context",
    "architecture_constraints",
    "scope",
    "acceptance_criteria",
    "implementation",
    "verification",
    "safety",
    "gates",
    "human_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "branch",
        "base_ref",
        "worktree"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory_files",
        "relevant_srs_sections",
        "active_iterations",
        "decisions",
        "excluded_context",
        "compressed_summary"
      ],
      "properties": {
        "mandatory_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "relevant_srs_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "active_iterations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 7,
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excluded_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "compressed_summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 6000
        }
      }
    },
    "architecture_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "source",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rule": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "required",
              "advisory"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_read_paths",
        "allowed_write_paths",
        "forbidden_paths",
        "max_changed_files"
      ],
      "properties": {
        "allowed_read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_write_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_changed_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "verification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{2,3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "verification": {
            "type": "string",
            "enum": [
              "test",
              "inspection",
              "command"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "assumptions",
        "out_of_scope"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^STEP-[0-9]{2,3}$"
              },
              "description": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1200
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_tests",
        "integration_tests",
        "commands"
      ],
      "properties": {
        "unit_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "integration_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lint",
            "typecheck",
            "test",
            "build"
          ],
          "properties": {
            "lint": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "typecheck": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "test": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "build": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_commit",
        "no_push",
        "no_merge",
        "no_pull_request",
        "no_dependency_install_without_approval",
        "no_network_unless_required",
        "no_secret_access",
        "no_destructive_commands"
      ],
      "properties": {
        "no_commit": {
          "const": true
        },
        "no_push": {
          "const": true
        },
        "no_merge": {
          "const": true
        },
        "no_pull_request": {
          "const": true
        },
        "no_dependency_install_without_approval": {
          "const": true
        },
        "no_network_unless_required": {
          "const": true
        },
        "no_secret_access": {
          "const": true
        },
        "no_destructive_commands": {
          "const": true
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_conditions",
        "retry_policy"
      ],
      "properties": {
        "blocker_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "retry_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_automatic_fix_rounds"
          ],
          "properties": {
            "max_automatic_fix_rounds": {
              "const": 1
            }
          }
        }
      }
    },
    "human_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "required": [
          "blocked_reason"
        ],
        "properties": {
          "human_questions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract_status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": [
              "null"
            ]
          }
        }
      }
    }
  ]
}
