#!/usr/bin/env bash
# Fake `claude` for agent-loop tests. Nihai mesajı STDOUT'a yazar — gerçek
# `claude -p` davranışı. `-o <dosya>` DESTEKLEMEZ; böylece codex/claude sonuç
# yakalama farkı gerçekten test edilir. Env ile sürülür:
#   STUB_CLAUDE_EXIT      non-zero -> stderr'e yaz ve o kodla çık (stdout boş)
#   STUB_CLAUDE_EMPTY=1   -> boş stdout, exit 0
#   STUB_CLAUDE_ECHO_PG=1 -> STATUS + forward edilen PG url/schema
#   STUB_CLAUDE_STATUS    -> sonucun ilk satırı (varsayılan "STATUS: SUCCESS")
#   STUB_CLAUDE_BODY      -> kalan gövde
#   STUB_CLAUDE_ARGV_LOG  -> verilirse alınan argv satır satır bu dosyaya yazılır
#   STUB_CLAUDE_CWD_LOG   -> verilirse çalışma dizini bu dosyaya yazılır
#   STUB_CLAUDE_STDERR    -> stderr'e yazılacak metin (sağlayıcı hatası taklidi)
#   STUB_CLAUDE_STDOUT_ERROR -> stdout'a bu metni yazıp non-zero çık (gerçek kota
#                               hatası davranışı: stderr boş, mesaj stdout'ta)
set -u

if [[ -n "${STUB_CLAUDE_ARGV_LOG:-}" ]]; then
  printf '%s\n' "$@" > "$STUB_CLAUDE_ARGV_LOG"
fi
if [[ -n "${STUB_CLAUDE_CWD_LOG:-}" ]]; then
  pwd > "$STUB_CLAUDE_CWD_LOG"
fi

# Prompt stdin'den gelir (rol otomatik tespiti için kullanılır).
prompt="$(cat 2>/dev/null || true)"

# Gerçek `claude -p` kota/oturum hatasını STDOUT'a yazıp non-zero çıkar; stderr
# boş kalır. Devir tespitinin bu kanalı da görmesi gerektiğini doğrular.
if [[ -n "${STUB_CLAUDE_STDOUT_ERROR:-}" ]]; then
  printf '%s\n' "${STUB_CLAUDE_STDOUT_ERROR}"
  exit "${STUB_CLAUDE_EXIT:-1}"
fi

if [[ -n "${STUB_CLAUDE_STDERR:-}" ]]; then
  printf '%s\n' "${STUB_CLAUDE_STDERR}" >&2
fi

if [[ -n "${STUB_CLAUDE_EXIT:-}" && "${STUB_CLAUDE_EXIT}" != "0" ]]; then
  echo "stub claude forced failure exit=${STUB_CLAUDE_EXIT}" >&2
  exit "${STUB_CLAUDE_EXIT}"
fi

if [[ "${STUB_CLAUDE_EMPTY:-0}" == "1" ]]; then
  exit 0
fi

status="${STUB_CLAUDE_STATUS:-}"
body="${STUB_CLAUDE_BODY:-stub body}"
if [[ -z "$status" ]]; then
  if grep -q "planning agent" <<<"$prompt"; then
    status="STATUS: READY"
    body=$'TASK_ID: demo-task\nTITLE: Demo task\nOBJECTIVE: demo objective\nSOURCE_DOCS: README.md\nPRIORITY_REASON: demo priority'
  elif grep -q "final reviewer" <<<"$prompt"; then
    status="STATUS: APPROVED"
    body="Demo approval."
  else
    status="STATUS: SUCCESS"
  fi
fi

echo "$status"
if [[ "${STUB_CLAUDE_ECHO_PG:-0}" == "1" ]]; then
  echo "PG_URL=${DATA_QUALITY_POSTGRES_TEST_URL:-}"
  echo "PG_SCHEMA=${DATA_QUALITY_DATABASE_SCHEMA:-}"
else
  printf '%s\n' "$body"
fi
exit 0
