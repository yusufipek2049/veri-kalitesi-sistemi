{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Task Contract v3",
  "description": "Resource-evidenced, minimalist, deterministically verifiable agent task contract",
  "type": "object",
  "required": ["schema_version", "contract_status", "iteration", "task", "repository", "scope", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3,
      "description": "Contract schema version. Only 3 is accepted."
    },
    "contract_status": {
      "type": "string",
      "enum": ["BOOTSTRAP", "READY", "IN_PROGRESS", "COMPLETED", "FAILED"],
      "description": "Current contract lifecycle status"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "Task iteration number"
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "objective", "selection_mode", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique task identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable task title"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "description": "Implementation objective"
        },
        "selection_mode": {
          "type": "string",
          "enum": ["manual", "automatic", "backlog"],
          "description": "How the task was selected"
        },
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["user_objective", "backlog", "bootstrap"],
              "description": "Source type: explicit user input, verified backlog, or bootstrap"
            },
            "reference": {
              "type": "string",
              "description": "Source reference (backlog ID, user quote, etc.)"
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "required": ["root", "branch", "base_ref"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Repository root path"
        },
        "branch": {
          "type": "string",
          "description": "Current git branch"
        },
        "base_ref": {
          "type": "string",
          "description": "Base git reference (HEAD at contract creation)"
        },
        "base_ref_policy": {
          "type": "string",
          "description": "Policy note: base_ref is informational only"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["allowed_files"],
      "additionalProperties": false,
      "properties": {
        "allowed_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Files that may be modified (empty = derive minimal scope)"
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Regex patterns that must not appear in changes"
        },
        "forbidden_git_operations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Git operations that are forbidden (checkout, reset, etc.)"
        }
      }
    },
    "must_disappear": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Files/patterns that must be physically deleted by task end"
    },
    "forbidden_substitutes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Regex patterns that must not appear as replacements for must_disappear"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime_rules": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Runtime constraints and rules"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    }
  }
}
